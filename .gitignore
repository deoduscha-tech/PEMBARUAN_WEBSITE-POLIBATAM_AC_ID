# =========================================================
#  Struktur: backend/ (Laravel)  +  frontend/ (Next.js)
# =========================================================

# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Build output
frontend/.next/
frontend/out/
frontend/build/
backend/public/build/
backend/public/hot

# Environment — berisi kredensial, JANGAN di-commit
.env
.env.local
.env.*.local
backend/.env
backend/.env.local
frontend/.env
frontend/.env.local
frontend/.env.*.local

# Log
*.log
logs/
frontend/logs/
backend/storage/logs/*.log

# Laravel runtime
backend/storage/framework/cache/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/storage/app/*.log
backend/bootstrap/cache/*
!backend/storage/framework/cache/.gitignore
!backend/storage/framework/sessions/.gitignore
!backend/storage/framework/views/.gitignore

# Sistem operasi
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
.fleet
.nova
.zed

# Arsip
*.zip
*.bak