# Front end Next.js — Pusat P2M Polibatam
# Semua variabel di bawah ini hanya dipakai di sisi server kecuali yang
# berawalan NEXT_PUBLIC_.

# Kredensial admin (padanan config/admin.php di Laravel).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Kunci tanda tangan cookie sesi. GANTI dengan string acak sebelum deploy.
ADMIN_SESSION_SECRET=ganti-dengan-string-acak-panjang-sebelum-deploy

# Hanya dipakai kalau nanti front end memanggil API eksternal.
NEXT_PUBLIC_API_URL=/api